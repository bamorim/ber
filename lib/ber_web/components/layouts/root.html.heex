<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{if assigns[:page_title], do: "#{@page_title} · "}Bernardo Amorim</title>
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/apple-touch-icon.png"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32x32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16x16.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css"
      integrity="sha384-K8MyQheOpUlTMhpk/Rxz4Rtn4VxtjdRLpEhsT/cdBJZeu9Q+2PxLoSpvgvkSwrR2"
      crossorigin="anonymous"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gray-200 dark:bg-gray-900 dark:text-gray-100">
    {@inner_content}
  </body>
</html>
